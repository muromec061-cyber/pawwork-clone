    "# ============================================================\n",
    "#  8. Keepalive — Colab не отключается\n",
    "# ============================================================\n",
    "import urllib.request\n",
    "import time\n",
    "\n",
    "def keepalive():\n",
    "    while True:\n",
    "        try:\n",
    "            urllib.request.urlopen(\n",
    "                urllib.request.Request(\n",
    "                    'http://localhost:8080/health',\n",
    "                    headers={'Authorization': f'Bearer {COLAB_API_KEY}'}\n",
    "                )\n",
    "            )\n",
    "            \n",
    "            # Ping ngrok чтобы не отвалился\n",
    "            if NGROK_AUTH_TOKEN != \"ВАШ_NGROK_AUTH_TOKEN\":\n",
    "                urllib.request.urlopen(f'{NGROK_URL}/health', timeout=10)\n",
    "            \n",
    "            # Ping Colab runtime guard\n",
    "            import requests\n",
    "            requests.get('https://colab.research.google.com/', timeout=5)\n",
    "        except:\n",
    "            pass\n",
    "        time.sleep(60)\n",
    "\n",
    "th = threading.Thread(target=keepalive, daemon=True)\n",
    "th.start()\n",
    "print('💓 Keepalive запущен (пинг каждые 60 секунд)')"
   ]
  },
