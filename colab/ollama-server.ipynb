   "source": [
    "# 🐾 PawWork Clone — Твой личный GGUF сервер\n",
    "\n",
    "Запускает твои модели (qwen2, Moonlight, kimi-vl) с личным API ключом.\n",
    "Сохрани этот ноутбук в Google Colab → Runtime → Run all\n",
    "\n",
    "## Что получишь:\n",
    "- Ollama сервер с твоими GGUF моделями\n",
    "- OpenAI-совместимый API с твоим ключом\n",
    "- ngrok URL (работает пока открыт Colab)\n",
    "- Авто-keepalive (Colab не отключается)\n",
    "\n",
    "## После запуска:\n",
    "Скопируй URL и API ключ в настройки Cloudflare Worker → COLAB_URL / COLAB_KEY"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "#  1. Установка зависимостей\n",
    "# ============================================================\n",
    "import os, sys, json, time, threading, uuid\n",
    "from datetime import datetime\n",
    "\n",
    "print('📦 Устанавливаю Ollama...')\n",
    "!curl -fsSL https://ollama.com/install.sh | bash 2>/dev/null\n",
    "\n",
    "print('📦 Устанавливаю ngrok...')\n",
    "!wget -q https://bin.equinox.io/c/bNyj1mQVY4c/ngrok-v3-stable-linux-amd64.tgz\n",
    "!tar xzf ngrok-v3-stable-linux-amd64.tgz -C /usr/local/bin/\n",
    "\n",
    "print('📦 Устанавливаю Python зависимости...')\n",
    "!pip install -q pyngrok fastapi uvicorn pydantic\n",
    "\n",
    "print('✅ Всё установлено!')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "#  2. Монтируем Google Drive (для хранения GGUF моделей)\n",
    "# ============================================================\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "\n",
    "MODELS_DIR = '/content/drive/MyDrive/ollama_models'\n",
    "os.makedirs(MODELS_DIR, exist_ok=True)\n",
    "print(f'📁 Модели будут храниться в: {MODELS_DIR}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "#  3. Запускаем Ollama сервер\n",
    "# ============================================================\n",
    "import subprocess\n",
    "\n",
    "print('🚀 Запускаю Ollama сервер...')\n",
    "ollama_process = subprocess.Popen(\n",
    "    ['ollama', 'serve'],\n",
    "    stdout=subprocess.PIPE, stderr=subprocess.PIPE\n",
    ")\n",
    "time.sleep(3)\n",
    "print('✅ Ollama сервер запущен на порту 11434')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "#  4. Импортируем GGUF модели из Google Drive\n",
    "# ============================================================\n",
    "import glob\n",
    "\n",
    "# Список моделей, которые будем использовать\n",
    "LOCAL_MODELS = {\n",
    "    'qwen2:0.5b': 'qwen2:0.5b',\n",
    "    'moonlight': 'hf.co/mmnga/Moonlight-16B-A3B-Instruct-gguf:Q3_K_M',\n",
    "    'kimi-vl': 'richardyoung/kimi-vl-a3b-thinking:latest',\n",
    "}\n",
    "\n",
    "print('🔍 Проверяю какие модели уже есть...')\n",
    "result = !ollama list 2>/dev/null\n",
    "existing = []\n",
    "for line in result:\n",
    "    if line.strip() and not line.startswith('NAME'):\n",
    "        existing.append(line.split()[0])\n",
    "print(f'   Уже в Ollama: {existing}')\n",
    "\n",
    "# Загружаем модели, которых нет\n",
    "for name, model_ref in LOCAL_MODELS.items():\n",
    "    if model_ref in existing:\n",
    "        print(f'   ✅ {name} уже загружена')\n",
    "        continue\n",
    "    print(f'   📥 Загружаю {name} ({model_ref})...')\n",
    "    !ollama pull {model_ref} 2>/dev/null\n",
    "    print(f'   ✅ {name} загружена')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "#  5. Запускаем ngrok туннель\n",
    "# ============================================================\n",
    "from pyngrok import ngrok\n",
    "\n",
    "# Твой AUTH TOKEN от ngrok (бесплатно: https://dashboard.ngrok.com/signup)\n",
    "NGROK_AUTH_TOKEN = \"ВАШ_NGROK_AUTH_TOKEN\"  # << ЗАМЕНИ НА СВОЙ\n",
    "\n",
    "if NGROK_AUTH_TOKEN != \"ВАШ_NGROK_AUTH_TOKEN\":\n",
    "    ngrok.set_auth_token(NGROK_AUTH_TOKEN)\n",
    "    tunnel = ngrok.connect(11434, \"http\")\n",
    "    NGROK_URL = tunnel.public_url\n",
    "else:\n",
    "    NGROK_URL = \"http://localhost:11434\"\n",
    "    print('⚠️ ngrok токен не настроен! API будет только локально в Colab.')\n",
    "\n",
    "print(f'🔗 ngrok URL: {NGROK_URL}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "#  6. API ключ и прокси-сервер\n",
    "# ============================================================\n",
    "COLAB_API_KEY = \"sk-colab-\" + uuid.uuid4().hex[:16]\n",
    "print(f'🔑 Твой API ключ: {COLAB_API_KEY}')\n",
    "print(f'🌐 API URL: {NGROK_URL}/v1/chat')\n",
    "print()\n",
    "print('📋 СКОПИРУЙ ЭТИ ДАННЫЕ В CLOUDFLARE WORKER:')\n",
    "print(f'   COLAB_URL = {NGROK_URL}')\n",
    "print(f'   COLAB_KEY = {COLAB_API_KEY}')\n",
    "print()\n",
    "print('Закрепи этот URL — он будет меняться при перезапуске Colab!')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "#  7. API прокси (OpenAI-совместимый, с авторизацией)\n",
    "# ============================================================\n",
    "from fastapi import FastAPI, HTTPException, Header\n",
    "from pydantic import BaseModel\n",
    "import uvicorn\n",
    "import httpx\n",
    "\n",
    "app = FastAPI()\n",
    "\n",
    "class ChatRequest(BaseModel):\n",
    "    model: str = 'qwen2:0.5b'\n",
    "    messages: list = []\n",
    "    max_tokens: int = 2048\n",
    "    temperature: float = 0.3\n",
    "    stream: bool = False\n",
    "\n",
    "class GenerateRequest(BaseModel):\n",
    "    model: str = 'qwen2:0.5b'\n",
    "    prompt: str = ''\n",
    "    system: str = ''\n",
    "    stream: bool = False\n",
    "\n",
    "@app.post(\"/v1/chat/completions\")\n",
    "@app.post(\"/v1/chat\")\n",
    "async def chat(req: ChatRequest, authorization: str = Header(None)):\n",
    "    if authorization != f\"Bearer {COLAB_API_KEY}\":\n",
    "        raise HTTPException(401, \"Unauthorized\")\n",
    "    \n",
    "    # Маппинг моделей\n",
    "    model_map = {\n",
    "        'qwen2:0.5b': 'qwen2:0.5b',\n",
    "        'moonlight': LOCAL_MODELS['moonlight'],\n",
    "        'kimi-vl': LOCAL_MODELS['kimi-vl'],\n",
    "        'default': 'qwen2:0.5b',\n",
    "    }\n",
    "    ollama_model = model_map.get(req.model, 'qwen2:0.5b')\n",
    "    \n",
    "    async with httpx.AsyncClient(timeout=120) as client:\n",
    "        r = await client.post('http://localhost:11434/api/chat', json={\n",
    "            'model': ollama_model,\n",
    "            'messages': req.messages,\n",
    "            'options': {\n",
    "                'num_predict': req.max_tokens,\n",
    "                'temperature': req.temperature,\n",
    "            }\n",
    "        })\n",
    "        res = r.json()\n",
    "    \n",
    "    return {\n",
    "        'choices': [{'message': {'role': 'assistant', 'content': res.get('message', {}).get('content', '')}}],\n",
    "        'model': req.model,\n",
    "        'provider': 'colab-ollama'\n",
    "    }\n",
    "\n",
    "@app.post(\"/api/generate\")\n",
    "async def generate(req: GenerateRequest, authorization: str = Header(None)):\n",
    "    if authorization != f\"Bearer {COLAB_API_KEY}\":\n",
    "        raise HTTPException(401, \"Unauthorized\")\n",
    "    \n",
    "    async with httpx.AsyncClient(timeout=120) as client:\n",
    "        r = await client.post('http://localhost:11434/api/generate', json={\n",
    "            'model': LOCAL_MODELS.get(req.model, 'qwen2:0.5b'),\n",
    "            'prompt': req.prompt,\n",
    "            'system': req.system,\n",
    "            'stream': False,\n",
    "        })\n",
    "        res = r.json()\n",
    "    \n",
    "    return {\n",
    "        'response': res.get('response', ''),\n",
    "        'model': req.model,\n",
    "    }\n",
    "\n",
    "@app.get(\"/v1/models\")\n",
    "async def list_models(authorization: str = Header(None)):\n",
    "    if authorization != f\"Bearer {COLAB_API_KEY}\":\n",
    "        raise HTTPException(401, \"Unauthorized\")\n",
    "    return {'models': list(LOCAL_MODELS.keys())}\n",
    "\n",
    "@app.get(\"/health\")\n",
    "async def health():\n",
    "    return {'status': 'ok', 'models': list(LOCAL_MODELS.keys())}\n",
    "\n",
    "print('🚀 Запускаю API сервер на порту 8080...')\n",
    "import threading\n",
    "server = threading.Thread(\n",
    "    target=uvicorn.run,\n",
    "    args=(app,),\n",
    "    kwargs={'host': '0.0.0.0', 'port': 8080, 'log_level': 'error'},\n",
    "    daemon=True\n",
    ")\n",
    "server.start()\n",
    "time.sleep(2)\n",
    "print(f'✅ API сервер запущен на порту 8080')"
   ]
  },
