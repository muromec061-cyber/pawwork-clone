    "    print(f'     -d \'{{\"model\":\"qwen2:0.5b\",\"messages\":[{{\"role\":\"user\",\"content\":\"Привет!\"}}]}}\'')\n",
    "print()\n",
    "print('   ⚠️ Colab отключится через ~12 часов')\n",
    "print('   Чтобы продлить: Runtime → Run all (модели останутся на Google Drive)')\n",
    "print('   ИЛИ используй автоматический перезапуск из Cloudflare Worker')\n",
    "print('='*60)\n",
    "\n",
    "# Держим ячейку активной\n",
    "import time\n",
    "while True:\n",
    "    time.sleep(300)"
   ]
